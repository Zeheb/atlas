# Atlas Environment Configuration
# Copy this file to .env and adjust for your local setup.
# .env is gitignored and must never be committed.

# Application
ATLAS_ENVIRONMENT=development        # development | production

# Repositories
ATLAS_REPOSITORY_BASE_PATH=repositories

# Logging (used by F-T3)
ATLAS_LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING | ERROR | CRITICAL
ATLAS_LOG_FILE_PATH=logs/atlas.log

# HTTP client (used by F-T4)
ATLAS_HTTP_TIMEOUT_SECONDS=30
ATLAS_HTTP_MAX_RETRIES=3
ATLAS_HTTP_RATE_LIMIT_RPS=2.0
