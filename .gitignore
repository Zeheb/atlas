# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Type checking and linting caches
.mypy_cache/
.ruff_cache/
.pyright/

# Evaluation harness LLM-response cache (regenerable, not a review artifact —
# eval_reports/ stays reserved for genuine, reviewable report output)
.eval_cache/

# eval_reports/: milestone and baseline reports (e.g. M1.5-baseline.json) are
# genuine review artifacts and are expected to be committed. Ad-hoc local
# development reruns are not — ignore those specifically by their existing
# "-dev"/"-rerun" naming convention rather than the directory as a whole.
eval_reports/*-dev.json
eval_reports/*-dev-*.json
eval_reports/*-rerun.json
eval_reports/*-rerun-*.json

# Test and coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# =============================================================================
# Data — ephemeral directories
# =============================================================================
data/cache/
data/exports/

# Do NOT ignore data/objects/ — object store is part of the project state
# (Reconsider if the object store grows too large for git)

# =============================================================================
# Repositories — downloaded evidence files (PDFs etc.)
# Metadata (company.json, catalog.json) is tracked; binaries are not.
# =============================================================================
repositories/**/*.pdf
repositories/**/*.xlsx
repositories/**/*.xls
repositories/**/*.zip

# Derived artifacts — regenerated by the knowledge and analysis pipelines
repositories/**/knowledge.db
repositories/**/assertions.db
repositories/**/acquisitions/

# A migration that dies between mkdtemp and the atomic move leaves one of
# these behind. It holds something shaped exactly like a store that nothing
# reads, so it must never be mistaken for tracked repository state.
repositories/**/.assertions-migrate-*/

# A stray knowledge.db at the repo root (not inside a company's repository
# directory) is local scratch state from a command run outside its intended
# working directory, not a project artifact.
/knowledge.db

# =============================================================================
# Secrets and environment
# =============================================================================
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials/

# =============================================================================
# Configuration overrides (local machine only)
# =============================================================================
configs/local.yaml

# =============================================================================
# Logs
# =============================================================================
*.log
logs/

# =============================================================================
# OS and editor artifacts
# =============================================================================
.DS_Store
Thumbs.db
Desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~

# =============================================================================
# Build and packaging tools
# =============================================================================
*.spec
.pdm-python
.pdm-build/

# =============================================================================
# Tooling output (regenerable caches from local dev tools, not project state)
# =============================================================================
graphify-out/
